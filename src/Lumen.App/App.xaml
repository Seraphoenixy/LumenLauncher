<Application x:Class="Lumen.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary>
    <SolidColorBrush x:Key="Surface" Color="#D91B1D23"/><SolidColorBrush x:Key="SurfaceRaised" Color="#30FFFFFF"/><SolidColorBrush x:Key="SurfaceHover" Color="#1FFFFFFF"/><SolidColorBrush x:Key="SurfaceSelected" Color="#35FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F7"/><SolidColorBrush x:Key="TextMuted" Color="#9B9CA5"/><SolidColorBrush x:Key="Accent" Color="#FF6363"/>
    <FontFamily x:Key="InterfaceFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="FontSize" Value="19"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/></Style>
  </ResourceDictionary></Application.Resources>
</Application>
