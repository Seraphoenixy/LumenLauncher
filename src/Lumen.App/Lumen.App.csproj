<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ApplicationIcon>Assets\Lumen.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest><Version>0.1.1</Version></PropertyGroup>
 <ItemGroup><ProjectReference Include="../Lumen.Core/Lumen.Core.csproj" /><ProjectReference Include="../Lumen.Infrastructure/Lumen.Infrastructure.csproj" /></ItemGroup>
 <ItemGroup>
  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
 </ItemGroup>
 <Target Name="BuildIndexer" BeforeTargets="CopyIndexer">
  <MSBuild Projects="$(MSBuildProjectDirectory)\..\Lumen.Indexer\Lumen.Indexer.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
 </Target>
 <Target Name="CopyIndexer" AfterTargets="Build" DependsOnTargets="BuildIndexer">
  <ItemGroup><IndexerFiles Include="$(MSBuildProjectDirectory)\..\Lumen.Indexer\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Lumen.Indexer.*;$(MSBuildProjectDirectory)\..\Lumen.Indexer\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\ToolGood.Words.Pinyin.dll" /></ItemGroup>
  <Copy SourceFiles="@(IndexerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
 </Target>
 <Target Name="CopyIndexerToPublishDirectory" AfterTargets="Publish">
  <ItemGroup><IndexerPublishFiles Include="$(MSBuildProjectDirectory)\..\Lumen.Indexer\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\Lumen.Indexer.*;$(MSBuildProjectDirectory)\..\Lumen.Indexer\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\ToolGood.Words.Pinyin.dll" /></ItemGroup>
  <Copy SourceFiles="@(IndexerPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
 </Target>
</Project>
