<Window x:Class="Lumen.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lumen 设置" Width="510" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#17181C" Foreground="{StaticResource Text}">
  <Border Padding="26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="修改启动器的全局快捷键和索引来源。" Foreground="{StaticResource TextMuted}" Margin="0,5,0,22"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="全局快捷键" FontWeight="SemiBold"/><TextBlock Text="修饰键以 + 分隔，例如 Alt+Ctrl" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBox x:Name="HotkeyModifiers" Background="#25262C" Padding="8,5" FontSize="13"/><TextBox x:Name="HotkeyKey" Background="#25262C" Padding="8,5" FontSize="13" Margin="0,6,0,0"/></StackPanel></Grid>
    <StackPanel Grid.Row="2" Margin="0,0,0,16"><TextBlock Text="便携应用目录" FontWeight="SemiBold"/><TextBlock Text="每行一个目录；重建索引后生效。" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,7"/><TextBox x:Name="PortableDirectories" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#25262C" Padding="9" FontSize="13"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,22"><CheckBox x:Name="HideOnDeactivated" Content="启动器失去焦点时自动隐藏" Foreground="{StaticResource Text}"/></StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Padding="15,7" Margin="0,0,8,0"/><Button Content="保存" IsDefault="True" Click="Save" Padding="15,7" Background="#FF6363" Foreground="White" BorderThickness="0"/></StackPanel>
  </Grid></Border>
</Window>
